set_property PACKAGE_PIN D5 [get_ports {AN[0]}]


# FIX: keypad pins were missing. Same physical pins as a known-working build, but the bit order is flipped
# to match Keypad.sv (there, physical row 1 / column 1 is bit 3: R1_on drives row = 4'b1000,
# and key "1" is column = 4'b1000).
set_property -dict {PACKAGE_PIN B13 IOSTANDARD LVCMOS33} [get_ports {row[3]}]
set_property -dict {PACKAGE_PIN A13 IOSTANDARD LVCMOS33} [get_ports {row[2]}]
set_property -dict {PACKAGE_PIN B14 IOSTANDARD LVCMOS33} [get_ports {row[1]}]
set_property -dict {PACKAGE_PIN A14 IOSTANDARD LVCMOS33} [get_ports {row[0]}]

# Columns need pull-downs so they read 0 when no key is pressed
set_property -dict {PACKAGE_PIN E12 IOSTANDARD LVCMOS33 PULLDOWN true} [get_ports {column[3]}]
set_property -dict {PACKAGE_PIN D12 IOSTANDARD LVCMOS33 PULLDOWN true} [get_ports {column[2]}]
set_property -dict {PACKAGE_PIN C13 IOSTANDARD LVCMOS33 PULLDOWN true} [get_ports {column[1]}]
set_property -dict {PACKAGE_PIN C14 IOSTANDARD LVCMOS33 PULLDOWN true} [get_ports {column[0]}]
