module mem_tb;


    parameter int WIDTH = 11;

    logic clk;
    logic write; 
    logic [1:0] address;
    logic [3:0] data;
    logic signed [WIDTH-1:0] ALU_result;
    logic [1:0] out_type;
    
    logic signed [WIDTH-1:0] out;
    

    memory_block dut (.write(write), .address(address), .data(data), .ALU_result(ALU_result), .out_type( out_type), .out(out), .clk(clk));
    
    always begin 
        #5 clk = ~clk;
    end
    
    initial begin
        
        write = 1; clk = 0; address = 2'b00; data = 4'b0010; out_type = 2'b00;  #1;
        write = 1; clk = 0; address = 2'b00; data = 4'b1000; out_type = 2'b00; #1;
        $finish;
    end

endmodule
