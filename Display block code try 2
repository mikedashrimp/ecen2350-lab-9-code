module Display_block(
        input logic clk,
        input logic signed [10:0] number, //11 bit input a, b, or ALU_result
    
    
        output logic [3:0] AN,
        output logic [7:0] SEG
        );
        
        logic negative;
        logic absval_num;

        always_comb begin(
        if (number < 0) begin
                negative = 1;
                absval_num = -number;
        else if (number > 0)
                negative = 0;
                absval_num = number;
        end
        )


