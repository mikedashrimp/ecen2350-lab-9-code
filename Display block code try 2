module digit_function(
        function disp_AN(logic [1:0] digit)
                case (digit)
                        2'b00 : begin // left motst digit (sign digit)
                                AN = 4'b0111;
                                SEG = negative ? SEG_LUT[10] : SEG_LUT[11];
                        end
                        2'b01 : begin // hundreds digit
                                AN = 4'b1011;
                                SEG = SEG_LUT[hundreds];
                        end

                        2'b10 : begin // tens digit
                                AN = 4'b1101;
                                SEG = SEG_LUT[tens];
                        end

                        2'b11 : begin // ones digit
                                AN = 4'b1110;
                                SEG = SEG_LUT[ones];
                        end
                endcase
        endfunction
)
endmodule


module Display_block(
        input logic clk,
        input logic signed [10:0] number, //11 bit input a, b, or ALU_result
    
    
        output logic [3:0] AN,
        output logic [7:0] SEG //{A, B, C, D, E, F, G, DP}
        );
        
        logic negative;
        logic absval_num;

        always_comb begin(
        if (number < 0) begin
                negative = 1;
                absval_num = -number;
        else if (number > 0)
                negative = 0;
                absval_num = number;
        end
        )

        logic [7:0] SEG_LUT [11:0] = {
        8'b0000_0011, // display 0
        8'b1001_1111, // display 1
        8'b0010_0101, // display 2
        8'b0000_1101, // display 3
        8'b1001_1001, // display 4
        8'b0100_1001, // display 5
        8'b0100_0001, // display 6
        8'b0001_1111, // display 7
        8'b0000_0001, // display 8
        8'b0000_1001, // display 9
        8'b1111_1101, // negative sign
        8'b1111_1111  // blank
        };

        logic hundreds;
        logic tens;
        logic ones;

        always_comb begin(
                hundreds = (absval_num - absval_num % 100)/100; 
                tens = (absval_num % 100 - absval_num % 10)/10;
                ones = absval_num % 10;
        )

        logic [1:0] digit;

        
                


