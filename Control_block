module Control_block (
    input  logic       clk,
    input  logic       reset,
    input  logic [3:0] column,
    output logic [3:0] row,
    output logic [3:0] AN,
    output logic [7:0] SEG
);

    // Internal interconnect wires
    logic [3:0]        key_data;
    logic              write;
    logic [1:0]        address;
    logic [1:0]        out_type;
    logic signed [10:0] a, b, alu_result, display_num;
    logic [1:0]        op;

    // 1. Keypad Scanner
    Keypad keypad_unit (
        .clk      (clk),
        .reset    (reset),
        .column   (column),
        .row      (row),
        .key_data (key_data)
    );

    // 2. Calculator Control FSM (translates key presses into memory control signals)
    CalculatorControl ctrl_unit (
        .clk      (clk),
        .reset    (reset),
        .column   (column),
        .key_data (key_data),
        .write    (write),
        .address  (address),
        .out_type (out_type)
    );

    // 3. Memory / Registers (11-bit signed)
    memory_block #(
        .WIDTH(11)
    ) mem_unit (
        .clk        (clk),
        .write      (write),
        .address    (address),
        .data       (key_data),
        .ALU_result (alu_result),
        .out_type   (out_type),
        .a          (a),
        .b          (b),
        .op         (op),
        .out        (display_num)
    );

    // 4. Arithmetic Logic Unit (overridden to WIDTH = 11 to match memory & display)
    ALU_block #(
        .WIDTH(11)
    ) alu_unit (
        .a  (a),
        .b  (b),
        .x  (alu_result),
        .op (op)
    );

    // 5. 4-Digit 7-Segment Display Driver
    Display_block disp_unit (
        .clk    (clk),
        .reset  (reset),
        .number (display_num),
        .AN     (AN),
        .SEG    (SEG)
    );

endmodule


