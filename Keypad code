module Input_block(
        input logic clk,
        input logic reset,
        input logic [3:0] column,

        output logic [3:0] row,
        output logic [3:0] key_data  
        );

        logic change_state;
        logic [15:0] count = 0;
        

        logic [1:0] digit;

        typedef enum logic [1:0] {
            R1_on,
            R2_on,
            R3_on,
            R4_on
        }row_state;

        row_state current_state, next_state;
        

        always_ff @(posedge clk) begin
           if (reset) begin
                current_state <= default;
           end                    
           else begin
                count <= count + 1;
                current_state <= next_state;
            end
        end

//        always_ff @(posedge clk) begin //short input delay
//                if (reset) begin
//                        current_state <= default;
//                end                    
//                else begin
//                        count <= count + 1;
//                        current_state <= next_state;
//                end
//        end


        assign change_state = (count == '1);
        
        always_comb begin
        
            next_state = current_state;
        
            if (change_state) begin
                case (current_state)
                    R1_on : next_state = R2_on;
                    R2_on : next_state = R3_on;
                    R3_on : next_state = R4_on;
                    R4_on : next_state = R1_on;
                    default : next_state = R1_on;
                endcase
            end
        end

        always_comb begin
            case (current_state)
                
                R1_on : begin
                        row = 4'b1000;
                        
                end
                R2_on : begin
                        row = 4'b0100;
                end
                R3_on : begin
                        row = 4'b0010;
                end
                R4_on : begin
                        row = 4'b0001;
                end
                default : begin
                        row = 4'b0000;
                end
            endcase
        end
endmodule
