module Input_block(
    input logic clk,
    input logic reset,
    input logic [3:0] column,

    output logic [3:0] row,
    output logic [3:0] key_data  
    );

    logic change_state;
    logic [15:0] count = 0;
    

    logic [1:0] digit;

    typedef enum logic [1:0] {
        R1_on,
        R2_on,
        R3_on,
        R4_on
    }row_state;

    row_state current_state, next_state;

    always_ff @(posedge clk) begin
       if (reset) begin
            current_state <= R1_on;
       end                    
       else begin
            count <= count + 1;
            current_state <= next_state;
        end
    end

    assign change_state = (count == '1);
    
    always_comb begin
    
        next_state = current_state;
    
        if (change_state) begin
            case (current_state)
                R1_on : next_state = R2_on;
                R2_on : next_state = R3_on;
                R3_on : next_state = R4_on;
                R4_on : next_state = R1_on;
                default : next_state = R1_on;
            endcase
        end
    end

    logic [3:0] prev_col;
    

    initial begin
        prev_col = 4'b0000;
            
    end

    always_comb begin
        case (current_state)
            
            R1_on : begin
                row = 4'b1000;
                if (column != prev_col) begin
                    case (column)
                        4'b1000 : key_data = 4'b0001;  // 1
                        4'b0100 : key_data = 4'b0010;  // 2
                        4'b0010 : key_data = 4'b0011;  // 3
                        4'b0001 : key_data = 4'b1100;  // +
                        default : key_data = 4'b0000;
                    endcase
                    prev_col = column;
                    end
            end
            R2_on : begin
                row = 4'b0100;
                if (column != prev_col) begin
                    case (column)
                        4'b1000 : key_data = 4'b0100;  // 4
                        4'b0100 : key_data = 4'b0101;  // 5
                        4'b0010 : key_data = 4'b0110;  // 6
                        4'b0001 : key_data = 4'b1101;  // -
                        default : key_data = 4'b0000;
                    endcase
                    prev_col = column;
                end

            end
            R3_on : begin
                row = 4'b0010;
                if (column != prev_col) begin
                    case (column)
                        4'b1000 : key_data = 4'b0111;  // 7
                        4'b0100 : key_data = 4'b1000;  // 8
                        4'b0010 : key_data = 4'b1001;  // 9
                        4'b0001 : key_data = 4'b1110;  // * "multipication"
                        default : key_data = 4'b0000;
                    endcase
                    prev_col = column;
                end

            end
            R4_on : begin
                row = 4'b0001;
                if (column != prev_col) begin
                    case (column)
                        4'b1000 : key_data = 4'b1010;  // * "not multiplication"
                        4'b0100 : key_data = 4'b0000;  // 0
                        4'b0010 : key_data = 4'b1011;  // #
                        4'b0001 : key_data = 4'b1111;  // '/'
                        default : key_data = 4'b0000;
                    endcase
                    prev_col = column;
                end

            end
            default : begin
                row = 4'b0000;

            end
        endcase
    end
endmodule 
