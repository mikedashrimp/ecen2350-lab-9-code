


module Display_block(
        input logic clk,
        input logic reset,
        input logic signed [3:0] key, //3 bit input 
    
    
        output logic [3:0] input_data,
        
        );
        
        
        
               
        logic change_state;
        logic [15:0] count = 0;
        
        logic [15:0] key [3:0] = {
                4'b0000
                4'b0001
                4'b0010
                4'b0011
                4'b0100
                4'b0101
                4'b0110
                4'b0111
                4'b1000
                4'b1001
                4'b1010
                4'b1011
                4'b1100
                4'b1101
                4'b1110
                4'b1111
        };

        

        logic [1:0] digit;

        typedef enum logic [1:0] {
            R1_on,
            R2_on,
            R3_on,
            R4_on
        }row_state;

        row_state current_state, next_state;
        

        always_ff @(posedge clk) begin
        //    if (reset) begin
        //        current_state <= dig_off;
            end                    
           else begin
                count <= count + 1;
                current_state <= next_state;
            end
        end
        
        assign change_state = (count == '1);
        
        always_comb begin
        
            next_state = current_state;
        
            if (change_state) begin
                case (current_state)
                    R1_on : next_state = R2_on;
                    R2_on : next_state = R3_on;
                    R3_on : next_state = R4_on;
                    R4_on : next_state = R1_on;
                    default : ;
                endcase
            end
        end

        always_comb begin
            case (current_state)
                
                R1_on : begin
                    AN = 4'b0111;
                    SEG = negative ? SEG_LUT[10] : SEG_LUT[11];
                end
                R2_on : begin
                    AN = 4'b1011;
                    SEG = SEG_LUT[hundreds];
                end
                R3_on : begin
                    AN = 4'b1101;
                    SEG = SEG_LUT[tens];
                end
                R4_on : begin
                    AN = 4'b1110;
                    SEG = SEG_LUT[ones];
                end
                default : begin
                    AN = 4'b1111;
                    SEG = SEG_LUT[11];
                end
            endcase
        end
endmodule
