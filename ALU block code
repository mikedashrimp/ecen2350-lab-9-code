module ALU_block(
    input logic [10:0] a,
    input logic [10:0] b,
    input logic [10:0] x,
    input logic [1:0] op
    );
    always_comb begin
        case (op)
            0'b00 : x = a + b;
            0'b01 : x = a - b;
            0'b10 : x = a * b;
            0'b11 : x = a / b;
            default : x = 0;
        endcase
    end 
endmodule
