`timescale 1ns / 1ps

module keypad_old_tb;
    logic clk;
    logic reset;
    logic [3:0] column;
    logic [3:0] row;
    logic [3:0] key_data;
    logic [1:0] data_type; 
    logic [0:0] new_input;  

    logic [0:0] key_pressed;
    logic [3:0] pressed_column;
    logic [3:0] pressed_row; 

    // Drive column only when key is pressed AND the currently scanned row matches pressed_row
    assign column = (key_pressed && (row & pressed_row) != 4'b0000) ? pressed_column : 4'b0000;

    Keypad dut (
        .clk(clk),
        .reset(reset),
        .column(column),
        .row(row),
        .key_data(key_data),
        .data_type(data_type),
        .new_input(new_input)
    );

    // 100 MHz clock (10 ns period)
    initial clk = 1'b0;
    always #5 clk = ~clk;

    task button_press(input [3:0] row_test, input [3:0] column_test);
        begin
            pressed_row    = row_test;
            pressed_column = column_test;
            key_pressed    = 1;
            
            // CRITICAL: Hold for at least 3 ms so the 4-row scan cycle (~2.6 ms) 
            // has enough time to reach your targeted row and catch the press!
            #3_000_000; 
            
            key_pressed    = 0;
            
            // Wait for release timer to finish before next press
            #1_000_000; 
        end
    endtask    
    
    initial begin
        reset = 1;
        key_pressed = 0;
        pressed_row = 4'b0000;
        pressed_column = 4'b0000;
        #200;
        reset = 0;
        #1000;
        
        // Test Row 1 keys (Row 1 = 4'b1000)
        // Press Key '1' (Row 1, Col 1 -> 4'b1000)
        button_press(4'b1000, 4'b1000); 
        
        // Press Key '2' (Row 1, Col 2 -> 4'b0100)
        button_press(4'b1000, 4'b0100); 
        
        $finish;
    end
endmodule
