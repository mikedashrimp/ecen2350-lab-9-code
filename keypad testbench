module keypad_old_tb;
    logic clk;
    logic reset;
    logic [3:0] column;
    logic [3:0] row;
    logic [3:0] key_data;
    logic [1:0] data_type; 
    logic [0:0] new_input;  

    logic [0:0] key_pressed;
    logic [3:0] pressed_column;
    logic [3:0] pressed_row; 

    // Drive column only when key is pressed AND the currently scanned row matches pressed_row
    assign column = (key_pressed && (row & pressed_row) != 4'b0000) ? pressed_column : 4'b0000;

    Keypad dut (
        .clk(clk),
        .reset(reset),
        .column(column),
        .row(row),
        .key_data(key_data),
        .data_type(data_type),
        .new_input(new_input)
    );

    task button_press(input [3:0] row_test, input [3:0] column_test);
        begin
            pressed_row    = row_test;
            pressed_column = column_test;
            key_pressed    = 1;
            
            // Wait longer than 1 full scan cycle (65,535 cycles * 10ns = ~655,350ns) 
            // so the FSM has time to reach and scan the target row.
            #800_000; 
            
            key_pressed    = 0;
            // Wait for release debounce timer (or a bit of time between presses)
            #200_000; 
        end
    endtask    

    // 100 MHz clock (10 ns period)
    initial clk = 1'b0;
    always #5 clk = ~clk;
    
    initial begin
        reset = 1;
        key_pressed = 0;
        pressed_row = 4'b0000;
        pressed_column = 4'b0000;
        #100;
        reset = 0;
        #1000;
        
        // Correct row mappings based on Keypad module:
        // Row 1 = 4'b1000
        // Row 2 = 4'b0100
        // Row 3 = 4'b0010
        // Row 4 = 4'b0001
        
        // Test Row 1 keys
        button_press(4'b1000, 4'b1000); // Key '1' (Row 1, Col 1)
        button_press(4'b1000, 4'b0100); // Key '2' (Row 1, Col 2)
        button_press(4'b1000, 4'b0010); // Key '3' (Row 1, Col 3)
        button_press(4'b1000, 4'b0001); // Key '+' (Row 1, Col 4)
        
        // Test Row 2 keys
        button_press(4'b0100, 4'b1000); // Key '4' (Row 2, Col 1)
        button_press(4'b0100, 4'b0100); // Key '5' (Row 2, Col 2)
        
        $finish;
    end
    
endmodule
